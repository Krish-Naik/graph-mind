# Copy to .env  (cp .env.example .env). dev.sh loads it automatically.

# MongoDB. Start it with:  docker compose up -d mongo
# Leave EMPTY to use a simple JSON file store instead (no database needed).
MONGO_URI=mongodb://127.0.0.1:27017/behavioral

# Shared folder for uploads + results (engine and server MUST use the same one). Default: ./data
# DATA_DIR=/absolute/path/to/data

# MAX_UPLOAD_MB=2048
